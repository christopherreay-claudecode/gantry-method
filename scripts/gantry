#!/usr/bin/env python3
"""gantry — the ONE entry point for putting a repo on the method (SPEC §8).

    gantry new    <dir>   [--name N] [--core-prefix P]... [--no-commit]
    gantry adopt  [<repo>] [--name N] [--core-prefix P]... [--link-tools] [--fresh-tools] [--no-seed] [--no-commit]
    gantry fork   <base> <new-dir> [--name N] [--level L | --issue-min N] [--keep-open]
                                   [--exclude PATH]... [--no-commit]
    gantry stream new    --issue NNNN --slug S [--brief FILE|-] [--prefix P] [--repo R]
    gantry stream list   [--repo R]
    gantry stream report [<prefix|slug>] [--all] [--repo R]
    gantry stream packet <prefix|slug> [--print] [--repo R]
    gantry stream launch <prefix|slug> [--cmd CMD] [--dry-run] [--repo R]
    gantry stream merge  <prefix|slug> [--repo R] [--keep-worktree] [--delete-branch] [--finish]
    gantry stream drop   <prefix|slug> [--repo R] [--keep-branch]
    gantry issue  new    --title T --refs A [A…] [--type T] [--deps "…"] [--repo R]
    gantry issue  close  <id> --by <sha|sentence> [--repo R]
    gantry map | open | next | show <id> | refresh | check      [--repo R]
    gantry install [--bin ~/.local/bin] [--name gantry] [--force]

`gantry install` puts this file on PATH, so every command below is `gantry …`
rather than `python3 /long/path/scripts/gantry …`.

In an adopted client the SAME program is installed as `tools/g` — the short,
token-cheap driver an agent uses all day:

    python3 tools/g map          the map without its navigation index
    python3 tools/g open         only the open items (+ their edges)
    python3 tools/g next         only what nothing blocks
    python3 tools/g show 42      one issue, its refs already resolved to constraint text
    python3 tools/g refresh      regenerate GRAPH.md + INDEX.md — one line back
    python3 tools/g issue new -t "…" -r 3 S1    ·    issue close 42 -b <sha>

Which one, in one line each (docs/00-llm-playbook.md has the long form):

  new     an EMPTY DIRECTORY (or none) that should become a gantry repo: mkdir,
          git init, then exactly what `adopt` does.
  adopt   an EXISTING git repo — empty or full of content — that should carry
          the method: scaffolds only what is missing (plan.md, seams.md,
          issues/, .gantry/adapter.json, CLAUDE.md section, .gitignore lines),
          copies the tools + wires both hooks (scripts/adopt.sh), seeds one
          milestone issue (M0: bootstrap) so the adoption commit itself obeys
          the commit law, and commits. Idempotent; never overwrites yours.
  fork    a NEW, SEPARATE repo born from a gantry-adopted base (the copy, not
          the link): tracked files at the base's HEAD minus excludes, identity
          edits, inherited issues closed as a reference set, level = base+1 so
          issues number from the next thousand, fresh init + birth commit,
          adopt, mint. Generic: any base; the SvelteKit-specific manifest fork
          stays in fork-app.sh.
  stream  a WORKTREE on a branch of the SAME repo, for an orchestrating agent:
          test workorders and parallel development streams. Spawned BY an
          issue; lives beside the repo (../.gantry.<repo>.streams.<prefix>);
          owns an issue NAMESPACE by stable prefix (#a42-0001 …) so parallel
          streams merge back without collision; seeded with #<prefix>-0001 —
          the brief (constraints / workorders to fulfil). Registered in
          .gantry/streams.json (committed by the parent). report = read each
          stream's GRAPH.md (the orchestrator's check); merge = fold back,
          parent adapter kept, derived files regenerated; drop = discard.
  issue   write a correctly-formed issue (exact header grammar; a mistake
          there floats silently) — body = constraints · depends on ·
          approaches · exit; close it by its type's authority.
  check   the CI gate: extract --check + gen_index --check + lineage sanity.

Numbering law (SPEC §8): a repo at lineage level L owns issue band
[L*1000, L*1000+999] (level 0 owns #0001–#0999); a FORK is one level down
(level 9, #9000–#9999, is the deepest). A STREAM does not take a band: it takes
a prefix — <parentPrefix><letter><parentIssueSeq> — and numbers #<prefix>-0001
onward. Numbers outside your band/namespace are never yours to file.

stdlib only. Shells out to git and to the sibling scripts (adopt.sh,
install-*.sh, gantry_extract.py, gen_index.py) — run it from anywhere.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import tempfile
import sys
from datetime import date, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
# The same program is the toolbox entry point (gantry/scripts/gantry) AND the
# client's own short driver (<client>/tools/g — copied, byte-identical). Only the
# scaffolding subcommands need the templates; the client copy resolves them if a
# toolbox is reachable and otherwise falls back to the inlined workorder body.
TEMPLATES = HERE / "templates"
def default_repo():
    """As <client>/tools/g the driver's home repo is its own parent — so
    `python3 tools/g open` needs no arguments from anywhere. As the toolbox entry
    point (or a PATH symlink into it) the default stays the current directory."""
    if HERE.name == "tools" and (HERE.parent / ".gantry").is_dir():
        return str(HERE.parent)
    return "."


WORKORDER_FALLBACK = """**Constraints this issue makes true (Tier 2 — each traces to a plan constraint in `refs:`):**
{{constraints}}

**Depends on:**
{{depends}}

**Approaches (the technical ways to satisfy the constraints; the one taken, and why):**
{{approaches}}

**Exit (what latches this):**
{{exit}}
"""
MAX_LEVEL = 9
HUMAN_GATED = {"ambiguity", "freeze-request", "amendment-proposal"}
ISSUE_GLOB = "[0-9][0-9][0-9][0-9]-*.md"


DEFAULT_REPO = None   # set below, once default_repo() is defined


# ------------------------------------------------------------------ util ----

def say(msg=""):
    print(msg)


def die(msg, code=1):
    print(f"gantry: {msg}", file=sys.stderr)
    sys.exit(code)


def git(repo, *args, check=True, capture=True):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=capture, text=True)
    if check and r.returncode != 0:
        die(f"git {' '.join(args)} failed in {repo}:\n{(r.stderr or r.stdout).strip()}")
    return r


def sh(cmd, cwd=None, check=True):
    r = subprocess.run(cmd, cwd=cwd, text=True)
    if check and r.returncode != 0:
        die(f"{' '.join(str(c) for c in cmd)} failed ({r.returncode})")
    return r


def load_json(p):
    return json.loads(Path(p).read_text(encoding="utf-8"))


def save_json(p, data):
    Path(p).write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def render(template_name, **kw):
    src = TEMPLATES / template_name
    if not src.exists() and template_name == "issue-workorder.md":
        text = WORKORDER_FALLBACK
    elif not src.exists():
        die(f"template {template_name} not found at {src} — run this subcommand from the "
            f"gantry toolbox (this is the client copy: tools/g)")
    else:
        text = src.read_text(encoding="utf-8")
    for k, v in kw.items():
        text = text.replace("{{" + k + "}}", str(v))
    left = re.findall(r"{{(\w+)}}", text)
    if left:
        die(f"template {template_name}: unfilled placeholders {left}")
    return text


def band_for_level(level):
    if level < 0 or level > MAX_LEVEL:
        die(f"lineage level {level} out of range 0..{MAX_LEVEL} (SPEC §8: ten levels, #0001–#9999)")
    return (1, 999) if level == 0 else (level * 1000, level * 1000 + 999)


def repo_root(path):
    p = Path(path).resolve()
    r = subprocess.run(["git", "-C", str(p), "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"not a git repo: {p}")
    return Path(r.stdout.strip())


def adapter_path(repo):
    return Path(repo) / ".gantry" / "adapter.json"


def load_adapter(repo):
    p = adapter_path(repo)
    if not p.exists():
        die(f"{repo} is not gantry-adopted (no {p}); run `gantry adopt {repo}` first")
    return load_json(p)


def issue_numbers(tracker, include_archived=False):
    """Numbers in the tracker. With include_archived, also everything in its
    subdirectories — a compressed tracker (issues/archive/) still owns those
    numbers, and re-issuing one would collide with history."""
    nums = []
    globber = Path(tracker).rglob if include_archived else Path(tracker).glob
    for f in sorted(globber(ISSUE_GLOB)):
        try:
            nums.append(int(f.name[:4]))
        except ValueError:
            pass
    return nums


def next_free_issue(tracker, lo, hi):
    taken = set(issue_numbers(tracker, include_archived=True))
    for n in range(lo, hi + 1):
        if n not in taken:
            return n
    die(f"no free issue number in band #{lo:04d}–#{hi:04d} — the band is exhausted; "
        f"open a sub-project (gantry fork / gantry stream) or amend the lineage plan")


def has_head(repo):
    return git(repo, "rev-parse", "HEAD", check=False).returncode == 0


def run_extract(repo, adapter=None, check=False, quiet=False):
    repo = Path(repo)
    adapter = adapter or adapter_path(repo)
    tool = repo / "tools" / "gantry_extract.py"
    if not tool.exists():
        tool = HERE / "gantry_extract.py"
    cmd = [sys.executable, str(tool), "--client", str(adapter), "--root", str(repo),
           "--out", str(repo / ".gantry" / "out" / "state.json"), "--digest", str(repo / "GRAPH.md")]
    deps = repo / ".gantry" / "deps.json"
    if deps.exists():
        cmd += ["--deps", str(deps)]
    if check:
        cmd.append("--check")
    return subprocess.run(cmd, capture_output=quiet, text=True)


def run_gen_index(repo, check=False, quiet=False):
    repo = Path(repo)
    tool = repo / "tools" / "gen_index.py"
    if not tool.exists():
        tool = HERE / "gen_index.py"
    cmd = [sys.executable, str(tool), "--root", str(repo)] + (["--check"] if check else [])
    return subprocess.run(cmd, capture_output=quiet, text=True)


# --------------------------------------------------------------- scaffold ----

def ensure_gitignore(repo):
    p = Path(repo) / ".gitignore"
    snippet = (TEMPLATES / "gitignore.snippet").read_text(encoding="utf-8")
    cur = p.read_text(encoding="utf-8") if p.exists() else ""
    if ".gantry/out/" in cur:
        return "kept"
    with p.open("a", encoding="utf-8") as fh:
        if cur and not cur.endswith("\n"):
            fh.write("\n")
        fh.write(("\n" if cur else "") + snippet)
    return "appended" if cur else "created"


GANTRY_BLOCK = re.compile(r"<!-- gantry:begin.*?<!-- gantry:end -->\n?", re.S)


def ensure_claude_md(repo, name, level, lo=0, hi=0, band=None):
    """CLAUDE.md carries ONE marker-delimited gantry block — a pointer to tools/README.md, where
    the ritual actually lives. The block is gantry's and is refreshed in place on every adopt;
    everything outside the markers is the project's own and is never touched (#0023)."""
    p = Path(repo) / "CLAUDE.md"
    section = render("CLAUDE.md", name=name, level=level,
                     band=band or f"#{lo:04d}–#{hi:04d}")
    block = GANTRY_BLOCK.search(section).group(0)
    if not p.exists():
        p.write_text(section, encoding="utf-8")
        return "created"
    cur = p.read_text(encoding="utf-8")
    if GANTRY_BLOCK.search(cur):
        fresh = GANTRY_BLOCK.sub(lambda _m: block, cur, count=1)
        if fresh == cur:
            return "kept (gantry block current)"
        p.write_text(fresh, encoding="utf-8")
        return "refreshed gantry block"
    with p.open("a", encoding="utf-8") as fh:
        fh.write(("" if cur.endswith("\n") else "\n") + "\n" + block)
    return "appended gantry block"


def ensure_file(repo, rel, template, **kw):
    p = Path(repo) / rel
    if p.exists():
        return "kept"
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(render(template, **kw), encoding="utf-8")
    return "created"


def scaffold(repo, name, level, lo, hi, lineage, seed=True, seed_title=None, lineage_note=""):
    """Create only what is missing. Returns the seed issue number (or None)."""
    repo = Path(repo)
    say(f"== scaffold: {repo}  (name: {name}, level {level}, band #{lo:04d}–#{hi:04d})")
    ad = adapter_path(repo)
    plan_rel, seams_rel, tracker_rel = "plan.md", "seams.md", "issues"
    if ad.exists():
        say(f"   kept: .gantry/adapter.json (already adopted — this run is idempotent; no re-seed)")
        a = load_json(ad)
        lo, hi = a.get("issue_min", lo) or lo, a.get("issue_max", hi) or hi
        seed = False
        # honor the client's own truth paths — never scaffold a second plan beside theirs
        plan_rel, seams_rel = a.get("plan", plan_rel), a.get("kickoff", seams_rel)
        tracker_rel = a.get("tracker_dir", tracker_rel)
    else:
        ad.parent.mkdir(parents=True, exist_ok=True)
        ad.write_text(render("adapter.json", name=name, issue_min=lo, issue_max=hi,
                             lineage=json.dumps(lineage)), encoding="utf-8")
        say("   created: .gantry/adapter.json  (FILL IN seam_slugs / q_holds as seams and holds appear)")

    r = ensure_file(repo, plan_rel, "plan.md", name=name)
    say(f"   {r}: {plan_rel}" + ("" if r == "created" else "  (existing — verify it has a `## 2.` constraint section)"))
    if r == "kept" and "## 2." not in (repo / plan_rel).read_text(encoding="utf-8"):
        say(f"   !!!  {plan_rel} has no `## 2.` section — extract parses constraints ONLY inside it (SPEC §6)")
    r = ensure_file(repo, seams_rel, "seams.md", name=name)
    say(f"   {r}: {seams_rel}")
    (repo / tracker_rel).mkdir(exist_ok=True)
    say(f"   {'kept' if issue_numbers(repo / tracker_rel) else 'created'}: {tracker_rel}/")
    say(f"   {ensure_gitignore(repo)}: .gitignore (.gantry/out/, .gantry/streams/)")
    say(f"   {ensure_claude_md(repo, name, level, lo, hi)}: CLAUDE.md")

    seed_no = None
    if seed:
        tracker = repo / tracker_rel
        existing_m0 = any("-m0-" in f.name or f.name[5:].startswith("m0-") for f in tracker.glob(ISSUE_GLOB))
        seed_no = next_free_issue(tracker, lo, hi)
        slug = "gantry-adoption" if existing_m0 else "m0-bootstrap"
        title = seed_title or (f"{name} — gantry adoption" if existing_m0 else f"{name} — plan, seams, first gate")
        p = tracker / f"{seed_no:04d}-{slug}.md"
        p.write_text(render("issue-seed.md", number=f"{seed_no:04d}", title=title,
                            lineage_note=lineage_note), encoding="utf-8")
        say(f"   seeded: issues/{p.name}  (the adoption commit refs it — no lint exemption needed)")
    return seed_no


def adopt_repo(repo, name, level, lo, hi, lineage, core_prefixes, link_tools=False,
               seed=True, commit=True, seed_title=None, lineage_note="", commit_msg=None,
               fresh_tools=False):
    repo = Path(repo)
    seed_no = scaffold(repo, name, level, lo, hi, lineage, seed=seed,
                       seed_title=seed_title, lineage_note=lineage_note)
    if fresh_tools:
        # upgrade an older client: overwrite its tools/ copies with this toolbox's
        # current, byte-identical programs (never symlinks — client content)
        (repo / "tools").mkdir(exist_ok=True)
        for t, src in (("gantry_extract.py", "gantry_extract.py"), ("gen_index.py", "gen_index.py"),
                       ("lint_commit.py", "lint_commit.py"), ("mmt.py", "mmt.py"), ("g", "gantry")):
            dst = repo / "tools" / t
            if dst.is_symlink():
                say(f"   kept: tools/{t} (symlink — already this toolbox)")
                continue
            shutil.copy2(HERE / src, dst)
            say(f"   refreshed: tools/{t} (--fresh-tools: current {'driver' if t == 'g' else 'extractor/ledger/lint'})")
        rd = repo / "tools" / "README.md"
        if not rd.is_symlink():
            rd.write_text((TEMPLATES.parent / "tools-README.template.md")
                          .read_text(encoding="utf-8")
                          .replace("{{gantry_repo}}", str(HERE.parent)), encoding="utf-8")
            say("   refreshed: tools/README.md (ritual + lineage + the stream/orchestration commands)")
    if link_tools:
        tools = repo / "tools"
        tools.mkdir(exist_ok=True)
        for t, srcname in (("gantry_extract.py", "gantry_extract.py"), ("gen_index.py", "gen_index.py"),
                           ("lint_commit.py", "lint_commit.py"), ("mmt.py", "mmt.py"), ("g", "gantry")):
            dst = tools / t
            src = HERE / srcname
            if dst.exists() or dst.is_symlink():
                say(f"   kept: tools/{t}")
                continue
            try:
                rel = Path(*([".."] * len(dst.parent.relative_to(repo).parts))) / src.relative_to(repo)
            except ValueError:
                rel = src
            dst.symlink_to(rel)
            say(f"   linked: tools/{t} -> {rel}  (--link-tools: this repo IS the toolbox)")
    cmd = ["sh", str(HERE / "adopt.sh"), str(repo)]
    for cp in core_prefixes:
        cmd += ["--core-prefix", cp]
    say("== adopt.sh (tools + both hooks + GRAPH.md mint)")
    sh(cmd)
    say("== issues/INDEX.md")
    run_gen_index(repo, quiet=True)
    if not commit:
        say("== --no-commit: tree left for you; commit with a message that refs "
            f"#{seed_no:04d}" if seed_no else "== --no-commit: tree left for you")
        return seed_no
    if seed_no is None and has_head(repo):
        # Re-adopt of an already-adopted repo: there is no seed issue to reference,
        # so this run must not commit. Keep a materially-changed GRAPH.md/INDEX.md
        # (the operator commits it against one of their own issues); revert only
        # dirt that is the commit STAMP alone — a fresh mint legitimately differs
        # from the committed digest in `@ <sha>[+dirty] · REV …`.
        stamp = re.compile(r"@ [0-9a-f]{7,40}(\+dirty)? · REV [0-9a-f]{12}")
        tdir = load_adapter(repo).get("tracker_dir", "issues")
        for rel in ("GRAPH.md", f"{tdir}/INDEX.md"):
            f = repo / rel
            if not f.exists():
                continue
            head_txt = git(repo, "show", f"HEAD:{rel}", check=False)
            if head_txt.returncode != 0:
                continue
            norm = lambda t: stamp.sub("@ <stamp>", t, count=1)
            if norm(head_txt.stdout) == norm(f.read_text(encoding="utf-8")) \
                    and head_txt.stdout != f.read_text(encoding="utf-8"):
                git(repo, "checkout", "--", rel, check=False)
                say(f"   reverted stamp-only churn: {rel}")
        dirty = git(repo, "status", "--porcelain", check=False).stdout.strip()
        if dirty:
            say("== changes present and no seed issue to reference — commit them yourself,")
            say("   against one of this repo's issues, e.g.:")
            say(f"     git -C {repo} add -A && git -C {repo} commit -m \"gantry tools refreshed (#NNNN)\"")
            for line in dirty.splitlines()[:12]:
                say(f"     {line}")
        else:
            say("== nothing to commit (already adopted, map up to date)")
        return None
    git(repo, "add", "-A")
    if not git(repo, "diff", "--cached", "--quiet", check=False).returncode == 0:
        ref = f" (#{seed_no:04d})" if seed_no else ""
        msg = commit_msg or f"gantry adopted{ref}"
        body = ("The method's operational layer: tools/ (GRAPH.md builder, ledger, commit law), "
                ".gantry/adapter.json, plan.md, seams.md, issues/, CLAUDE.md briefing. "
                "GRAPH.md is minted by the pre-commit shim into this same commit.")
        say(f"== commit: {msg}")
        r = git(repo, "commit", "-q", "-m", msg, "-m", body, check=False, capture=False)
        if r.returncode != 0:
            die("adoption commit failed (see the lint output above)")
    else:
        say("== nothing to commit (already adopted)")
    return seed_no


# ------------------------------------------------------------ new / adopt ----

def cmd_new(a):
    d = Path(a.dir).resolve()
    if d.exists() and any(d.iterdir()):
        die(f"{d} is not empty — use `gantry adopt {d}` for a repo with content")
    d.mkdir(parents=True, exist_ok=True)
    if not (d / ".git").exists():
        git(d, "init", "-q")
        say(f"== git init: {d}")
    name = a.name or d.name
    lo, hi = band_for_level(0)
    seed_no = adopt_repo(d, name, 0, lo, hi, {"level": 0, "kind": "root"}, a.core_prefix,
                         seed=True, commit=not a.no_commit)
    say("")
    say("NEXT (the developer LLM):")
    say(f"   1. read {d}/GRAPH.md, then tools/README.md")
    say("   2. Tier-1 interview → write plan.md §2 (numbered constraints), seams.md, the near-phase gates")
    say(f"   3. land the plan with a commit `… (closes #{seed_no:04d})` — gate m0 latches")
    say("   4. every commit from here refs an issue; declare deps: the moment you learn them")


def cmd_adopt(a):
    repo = repo_root(a.repo)
    name = a.name or repo.name
    lo, hi = band_for_level(0)
    seed_no = adopt_repo(repo, name, 0, lo, hi, {"level": 0, "kind": "root"}, a.core_prefix,
                         link_tools=a.link_tools, seed=not a.no_seed, commit=not a.no_commit,
                         fresh_tools=a.fresh_tools)
    say("")
    say("NEXT (the developer LLM):")
    say(f"   1. read {repo}/GRAPH.md, then tools/README.md")
    say("   2. Tier-1 interview → write plan.md §2 (numbered constraints) FROM THE EXISTING CODE'S felt")
    say("      outcomes; seams.md for every scheduled swap; one milestone issue per near-phase gate,")
    say("      one hold per known open question — nothing speculative")
    if seed_no:
        say(f"   3. land the plan with a commit `… (closes #{seed_no:04d})` — gate m0 latches")
    say("   4. every commit from here refs an issue; a core path (--core-prefix) needs one too")


# ------------------------------------------------------------------- fork ----

DEFAULT_FORK_EXCLUDES = [".gantry/out", ".gantry/streams", ".gantry/streams.json", "GRAPH.md",
                         "issues/INDEX.md", ".env", "node_modules", "METALAND"]


def close_inherited(tracker, sha):
    """Inherited issues are a closed reference set (SPEC §8): their work belonged
    to the base. Commit-closable types get the fork-point sha; human-gated types
    get a sign-off sentence — closure authority respected in both directions."""
    closed = 0
    for p in sorted(Path(tracker).glob(ISSUE_GLOB)):
        lines = p.read_text(encoding="utf-8").splitlines()
        typ = st = None
        for line in lines[:6]:
            m = re.match(r"^type:\s*(\S+)\s+status:\s*(\S+)", line)
            if m:
                typ, st = m.group(1), m.group(2)
        if st != "open":
            continue
        for i, line in enumerate(lines[:6]):
            if re.match(r"^type:\s*\S+\s+status:\s*open", line):
                lines[i] = re.sub(r"status:\s*open", "status: closed", line, count=1)
                break
        for i, line in enumerate(lines[:6]):
            if line.startswith("refs:"):
                cb = f"reference: inherited from base @ {sha}" if typ in HUMAN_GATED else sha
                if "closed-by:" in line:
                    lines[i] = re.sub(r"closed-by:\s*.*$", "closed-by: " + cb, line)
                else:
                    lines[i] = line.rstrip() + "   closed-by: " + cb
                break
        p.write_text("\n".join(lines) + "\n", encoding="utf-8")
        closed += 1
        say(f"   closed: {p.name} ({'human-gated' if typ in HUMAN_GATED else 'commit-closable'})")
    say(f"   {closed} inherited issues closed (reference set)")


def cmd_fork(a):
    base = repo_root(a.base)
    base_ad = load_adapter(base)
    new = Path(a.new_dir).resolve()
    new.mkdir(parents=True, exist_ok=True)
    if any(new.iterdir()):
        die(f"refusing: {new} is not empty")
    name = a.name or new.name
    if not has_head(base):
        die(f"{base} has no commits — a fork copies the base's HEAD")
    if git(base, "status", "--porcelain", check=False).stdout.strip():
        say("   note: base has uncommitted changes — a fork copies HEAD; those changes are NOT copied")
    base_sha = git(base, "rev-parse", "HEAD").stdout.strip()
    base_level = int((base_ad.get("lineage") or {}).get("level", 0))
    if a.issue_min is not None:
        lo = a.issue_min
        level = max(base_level + 1, lo // 1000)
        hi = (lo // 1000) * 1000 + 999 if lo >= 1000 else 999
    else:
        level = a.level if a.level is not None else base_level + 1
        lo, hi = band_for_level(level)
    if level > MAX_LEVEL:
        die(f"base is at level {base_level}; a fork would be level {level} > {MAX_LEVEL}")

    say(f"== gantry fork: {base} @ {base_sha[:7]} -> {new}  (name {name}, level {level}, "
        f"issues #{lo:04d}–#{hi:04d})")
    # 1. copy: tracked files at HEAD (git archive), then remove excludes
    tar = subprocess.Popen(["git", "-C", str(base), "archive", "--format=tar", "HEAD"],
                           stdout=subprocess.PIPE)
    r = subprocess.run(["tar", "-x", "-C", str(new)], stdin=tar.stdout)
    tar.wait()
    if tar.returncode or r.returncode:
        die("copy (git archive | tar) failed")
    excludes = DEFAULT_FORK_EXCLUDES + list(a.exclude or [])
    manifest = base / ".gantry" / "fork-exclude"
    if manifest.exists():
        excludes += [l.strip() for l in manifest.read_text().splitlines()
                     if l.strip() and not l.startswith("#")]
    for ex in excludes:
        p = new / ex
        if p.exists() or p.is_symlink():
            shutil.rmtree(p) if p.is_dir() and not p.is_symlink() else p.unlink()
            say(f"   excluded: {ex}")
    say(f"   copied: tracked files of base @ {base_sha[:7]} (derived files excluded — they regenerate)")
    if a.fresh_tools:
        (new / "tools").mkdir(exist_ok=True)
        for t in ("gantry_extract.py", "gen_index.py", "lint_commit.py"):
            shutil.copy2(HERE / t, new / "tools" / t)
            say(f"   refreshed: tools/{t} (--fresh-tools)")

    # 2. identity edits
    ad = load_json(adapter_path(new))
    ad["client"] = name
    ad["issue_min"], ad["issue_max"] = lo, hi
    ad["lineage"] = {"level": level, "kind": "fork",
                     "parent": {"repo": base_ad.get("client", base.name), "path": str(base),
                                "commit": base_sha}}
    # key order: keep the canonical shape (client, tracker_dir, issue_min, issue_max, lineage, ...)
    ordered = {k: ad[k] for k in ("client", "tracker_dir", "issue_min", "issue_max", "lineage") if k in ad}
    ordered.update({k: v for k, v in ad.items() if k not in ordered})
    save_json(adapter_path(new), ordered)
    say(f"   set: .gantry/adapter.json client={name} issue_min={lo} issue_max={hi} lineage=fork level {level}")
    pkg = new / "package.json"
    if pkg.exists():
        t = pkg.read_text(encoding="utf-8")
        t = re.sub(r'^(\s*"name":\s*)"[^"]*"', rf'\1"{name}"', t, count=1, flags=re.M)
        pkg.write_text(t, encoding="utf-8")
        say(f"   set: package.json name={name}")
    cfg = new / "supabase" / "config.toml"
    if cfg.exists():
        t = re.sub(r'project_id = "[^"]*"', f'project_id = "{name}"', cfg.read_text(encoding="utf-8"))
        cfg.write_text(t, encoding="utf-8")
        say(f"   set: supabase/config.toml project_id={name}")
    readme = new / "README.md"
    head = (f"# {name}\n\n> Born from **{base_ad.get('client', base.name)}** @ {base_sha[:7]} — a gantry fork "
            f"(lineage level {level}). This repo's issues are numbered **#{lo:04d}–#{hi:04d}**; the "
            f"inherited issues are the closed reference set. Session start: read `GRAPH.md`, then "
            f"`tools/README.md`.\n\n")
    readme.write_text(head + (readme.read_text(encoding="utf-8") if readme.exists() else ""), encoding="utf-8")
    say("   set: README.md fork header")
    cl = new / "CLAUDE.md"
    if cl.exists():
        cl.unlink()
    ensure_claude_md(new, name, level, lo, hi)
    say("   set: CLAUDE.md briefing (band + lineage)")

    # 3. reference set
    if a.keep_open:
        say("== inherited issues kept OPEN (--keep-open)")
    else:
        say("== close the inherited issues (reference set; their work belongs to the base)")
        close_inherited(new / ad.get("tracker_dir", "issues"), base_sha[:7])

    # 4. git init + birth commit (exempt from commit law: no issue of this repo exists yet)
    git(new, "init", "-q")
    git(new, "add", "-A")
    if a.no_commit:
        say("== --no-commit: tree staged for you")
    else:
        git(new, "commit", "-q", "--no-verify", "-m", f"repo born from {base_ad.get('client', base.name)} @ {base_sha[:7]}",
            "-m", f"gantry fork, lineage level {level}. Inherited issues are a closed reference set; "
                  f"this repo's issues are numbered from {lo:04d}. Birth commit is exempt from commit "
                  f"law: no issue exists yet — the first issue ({lo:04d}) carries the ref from here on.")
        say(f"== birth commit: repo born from base @ {base_sha[:7]}")

    # 5. adopt (tools already present from the copy → kept; hooks wired; GRAPH.md minted)
    say("== adopt.sh (hooks; tools kept from the base copy)")
    sh(["sh", str(HERE / "adopt.sh"), str(new)])
    run_gen_index(new, quiet=True)
    if a.no_commit or not has_head(new):
        pass
    else:
        say(f"   GRAPH.md + issues/INDEX.md minted (uncommitted — commit them with the first issue)")
    say("")
    say("NEXT (the operator / orchestrating LLM):")
    say(f"   - copy secrets by hand (.env), never via git")
    say(f"   - file the first issue: issues/{lo:04d}-<slug>.md (refs the inherited constraint it serves)")
    say(f"   - commit it WITH GRAPH.md + issues/INDEX.md — that commit carries the #{lo:04d} ref")
    say(f"   - 'below issue_min' warnings on inherited issues are expected (copied history)")


# ----------------------------------------------------------------- stream ----
#
# A stream is a worktree on a branch of the SAME repo, spawned BY an issue, with
# its own issue NAMESPACE: a stable prefix (identity, not position), so any set
# of parallel streams can merge back without a collision. Prefix rule:
#     <parent's own prefix><letter><parent issue seq>
# stream a of #0042 in a root repo -> "a42"; its issues are #a42-0001, #a42-0002 …
# a stream b spawned inside it from #a42-0003 -> "a42b3". Letters are allocated
# per parent issue and never re-used (streams.json is the ledger).
# The worktree lives BESIDE the repo: ../.gantry.<repoDirName>.streams.<prefix>

ISSUE_PREFIX_RE = re.compile(r"^[a-z][a-z0-9]{0,11}$")
ISSUE_ID_RE = re.compile(r"^(?:([a-z][a-z0-9]{0,11})-)?(\d{4})$")


def streams_path(repo):
    return Path(repo) / ".gantry" / "streams.json"


def load_streams(repo):
    p = streams_path(repo)
    return load_json(p) if p.exists() else {"streams": []}


def save_streams(repo, data):
    save_json(streams_path(repo), data)


def find_stream(data, key):
    for s in data["streams"]:
        if key in (s["slug"], s["prefix"]):
            return s
    die(f"no stream '{key}' (slug or prefix) in .gantry/streams.json")


def stream_worktree(repo, prefix):
    """../.gantry.<repoDirName>.streams.<prefix> — beside the repo. A stream of a
    stream keeps the ROOT repo's name (so nesting does not nest the dir name)."""
    repo = Path(repo)
    m = re.match(r"^\.gantry\.(.+)\.streams\.[a-z0-9]+$", repo.name)
    base = m.group(1) if m else repo.name
    return repo.parent / f".gantry.{base}.streams.{prefix}"


def parse_issue_header(path):
    """(id, title, type, status, refs-line) from an issue file's first 6 lines."""
    lines = Path(path).read_text(encoding="utf-8").splitlines()[:6]
    iid = title = typ = st = refs = None
    for l in lines:
        m = re.match(r"^#\s+#((?:[a-z][a-z0-9]{0,11}-)?\d{4})\s+—\s+(.+)$", l)
        if m:
            iid, title = m.group(1), m.group(2).strip()
        m = re.match(r"^type:\s*(\S+)\s+status:\s*(\S+)", l)
        if m:
            typ, st = m.group(1), m.group(2)
        m = re.match(r"^refs:\s*(.*?)\s+opened:", l)
        if m:
            refs = m.group(1).strip()
    return iid, title, typ, st, refs


def tracker_issue(tracker, iid):
    """Path of issue <iid> ('0042' or 'a42-0003') — live first, then archived
    (a compressed tracker keeps closed issues in issues/archive/)."""
    hits = sorted(Path(tracker).glob(f"{iid}-*.md")) or sorted(Path(tracker).rglob(f"{iid}-*.md"))
    return hits[0] if hits else None


def next_free_prefixed(tracker, prefix):
    seqs = [int(f.name[len(prefix) + 1:len(prefix) + 5])
            for f in Path(tracker).rglob(f"{prefix}-[0-9][0-9][0-9][0-9]-*.md")]
    return max(seqs, default=0) + 1


def cmd_stream_new(a):
    repo = repo_root(a.repo)
    ad = load_adapter(repo)
    if not has_head(repo):
        die("no commits yet — a stream branches from HEAD")
    tracker = repo / ad.get("tracker_dir", "issues")
    # the spawning issue: '42', '0042', or 'a42-3' / 'a42-0003'
    raw = a.issue.lstrip("#")
    ipfx, _, seq = raw.rpartition("-")
    if not seq.isdigit() or (ipfx and not ISSUE_PREFIX_RE.match(ipfx)):
        die(f"--issue must be NNNN or <prefix>-NNNN, got '{a.issue}'")
    iseq = int(seq)
    issue = f"{ipfx}-{iseq:04d}" if ipfx else f"{iseq:04d}"
    ipath = tracker_issue(tracker, issue)
    if not ipath:
        die(f"parent issue #{issue} not found in {tracker} — file the workorder first; a stream is "
            f"always spawned BY an issue")
    _, ititle, _, _, irefs = parse_issue_header(ipath)
    slug = re.sub(r"[^a-z0-9-]+", "-", a.slug.lower()).strip("-")
    full = f"{issue}-{slug}"
    data = load_streams(repo)
    if any(s["slug"] == full for s in data["streams"]):
        die(f"stream {full} already exists")
    own = ad.get("issue_prefix") or ""
    if a.prefix:
        prefix = a.prefix
        if not ISSUE_PREFIX_RE.match(prefix):
            die(f"--prefix must match [a-z][a-z0-9]{{0,11}}, got '{prefix}'")
    else:
        used = {s["prefix"] for s in data["streams"]}
        prefix = next((f"{own}{c}{iseq}" for c in "abcdefghijklmnopqrstuvwxyz"
                       if f"{own}{c}{iseq}" not in used), None)
        if prefix is None:
            die(f"26 streams already spawned from #{issue} — pass --prefix explicitly")
    if any(s["prefix"] == prefix for s in data["streams"]):
        die(f"prefix '{prefix}' already registered")
    level = int((ad.get("lineage") or {}).get("level", 0)) + 1
    branch = f"stream/{full}"
    wt = stream_worktree(repo, prefix)
    if wt.exists():
        die(f"{wt} exists")
    from_sha = git(repo, "rev-parse", "HEAD").stdout.strip()
    from_branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    issue_high = max(issue_numbers(tracker), default=0)
    brief, extra = "", []
    if a.brief:
        raw = sys.stdin.read() if a.brief == "-" else Path(a.brief).read_text(encoding="utf-8")
        brief, extra = parse_brief(raw)

    say(f"== gantry stream new: {full}  (prefix {prefix}, level {level}, branch {branch})")
    git(repo, "worktree", "add", "-q", "-b", branch, str(wt), "HEAD")
    say(f"   worktree: {wt}")

    # the stream's own adapter (on ITS branch): prefix + lineage. On merge the
    # parent keeps its own adapter (gantry stream merge restores it).
    wad = load_json(adapter_path(wt))
    wad["issue_prefix"] = prefix
    wad["lineage"] = {"level": level, "kind": "stream", "branch": branch, "prefix": prefix,
                      "parent": {"repo": ad.get("client", repo.name), "issue": issue,
                                 "branch": from_branch, "commit": from_sha, "issue_high": issue_high}}
    ordered = {k: wad[k] for k in ("client", "tracker_dir", "issue_min", "issue_max", "issue_prefix", "lineage") if k in wad}
    ordered.update({k: v for k, v in wad.items() if k not in ordered})
    save_json(adapter_path(wt), ordered)
    # a fresh ledger for the stream's own sub-streams (the parent's is the parent's)
    save_streams(wt, {"streams": []})
    cl = wt / "CLAUDE.md"
    if cl.exists():
        cl.unlink()
    ensure_claude_md(wt, f"{ad.get('client', repo.name)} · stream {full}", level,
                     band=f"#{prefix}-0001…  (your namespace: every issue you file is #{prefix}-NNNN)")
    with cl.open("a", encoding="utf-8") as fh:
        fh.write(f"\nThis is **stream `{full}`** (prefix `{prefix}`) — a worktree on branch `{branch}`, "
                 f"spawned by parent issue **#{issue}** ({ititle}). Start from `#{prefix}-0001`: it "
                 f"states the constraints this stream must make true. Work them; file every further "
                 f"issue as `#{prefix}-NNNN` (`python3 <gantry>/scripts/gantry issue new --repo . …`), "
                 f"each refs a constraint of the shared plan; commit against them. **Everything you do "
                 f"must show in `GRAPH.md`** — that is what the orchestrator reads "
                 f"(`gantry stream report {prefix}`). Do not file bare `#NNNN` numbers (they collide "
                 f"on merge). When done, close your issues by their type's authority and say so in "
                 f"the last commit; the orchestrator merges or drops the stream.\n\n"
                 f"**Boundaries:** `plan.md` and `seams.md` are amendment-only truth — you `refs:` them, "
                 f"you never edit them (open an `amendment-proposal` if one seems wrong). Do not edit "
                 f"inherited issues beyond a closing note; do not touch `.gantry/adapter.json`, "
                 f"`.gantry/streams.json`, `GRAPH.md`, `issues/INDEX.md` (derived / the parent's). Do not "
                 f"merge, rebase or push — the orchestrator does. **Read first:** `.gantry/packet.md` "
                 f"(the method in brief + your workorders + the constraints they resolve to), then `GRAPH.md`.\n")
    # seed: the stream's brief — its own first workorder, pointing at the
    # parent's constraints (refs copied), carrying the orchestrator's brief.
    seed = tracker_issue(wt / ad.get("tracker_dir", "issues"), f"{prefix}-0001")
    seed_path = wt / ad.get("tracker_dir", "issues") / f"{prefix}-0001-{slug}.md"
    refs_line = irefs if irefs else "[m0]"
    body = brief.strip() or (f"Fulfil the constraints of #{issue} ({ititle}). Read that issue for the "
                             f"constraints and its dependencies; this stream's job is the technical "
                             f"solution — express each piece of work as its own issue "
                             f"(#{prefix}-NNNN) stating the constraints it makes true, what it depends "
                             f"on, and the approach chosen.")
    seed_path.write_text(
        f"# #{prefix}-0001 — {slug}: workorder from #{issue}\n"
        f"type: workorder        status: open\n"
        f"refs: {refs_line}   opened: stream   closed-by: <sha>\n"
        f"deps: informs #{issue}\n\n"
        f"**Constraints to make true (from #{issue} — {ititle}):** see the parent workorder; the "
        f"anchors above are its anchors.\n\n"
        f"**Brief from the orchestrator:**\n\n{body}\n\n"
        f"**Exit:** every issue this stream files is closed by its type's authority; `GRAPH.md` on "
        f"branch `{branch}` shows the result; the orchestrator reads it and merges or drops.\n",
        encoding="utf-8")
    say(f"   seeded: {seed_path.relative_to(wt)}  (the stream's brief; refs = #{issue}'s anchors)")
    for k, ex in enumerate(extra, start=2):
        eslug = re.sub(r"[^a-z0-9-]+", "-", ex["title"].lower()).strip("-")[:48]
        erefs = ex["refs"] or refs_line
        ep = wt / ad.get("tracker_dir", "issues") / f"{prefix}-{k:04d}-{eslug}.md"
        cb = "<a human sentence>" if ex["type"] in HUMAN_GATED else "<sha>"
        head = [f"# #{prefix}-{k:04d} — {ex['title']}",
                f"type: {ex['type']}        status: open",
                f"refs: {erefs}   opened: stream   closed-by: {cb}"]
        deps = ex["deps"] or f"informs #{prefix}-0001"
        head.append(f"deps: {deps}")
        ep.write_text("\n".join(head) + "\n\n" + (ex["body"] or "(no body in the brief — state the "
                      "constraints this makes true, what it depends on, the approach, the exit)") + "\n",
                      encoding="utf-8")
        say(f"   seeded: {ep.relative_to(wt)}  (from the brief's `## issue:` block)")
    gi = wt / ".gitignore"
    cur = gi.read_text(encoding="utf-8") if gi.exists() else ""
    if ".gantry/packet.md" not in cur:
        with gi.open("a", encoding="utf-8") as fh:
            fh.write(("" if cur.endswith("\n") or not cur else "\n") +
                     "# gantry — stream launch artifacts (regenerated)\n.gantry/packet.md\n.gantry/run.*.json\n")
    write_packet(wt)
    say(f"   packet: .gantry/packet.md  (the sub-model's first input; `gantry stream packet {prefix}` regenerates; gitignored)")
    git(wt, "add", "-A")
    r = git(wt, "commit", "-q", "-m", f"stream {full} opened (#{issue}, #{prefix}-0001)",
            "-m", f"gantry stream: prefix {prefix}, level {level}, from {from_branch} @ {from_sha[:7]}.",
            check=False)
    if r.returncode != 0:
        die(f"stream commit failed:\n{(r.stderr or r.stdout).strip()}")
    say(f"   committed on {branch}: adapter (prefix + lineage), CLAUDE.md briefing, seed #{prefix}-0001")

    data["streams"].append({"slug": full, "prefix": prefix, "issue": issue, "branch": branch,
                            "worktree": str(wt), "from": from_sha, "status": "open"})
    save_streams(repo, data)
    say(f"   registered: .gantry/streams.json (commit it in the parent, refs #{issue})")
    say("")
    say("NEXT (the orchestrator):")
    say(f"   - git -C {repo} add .gantry/streams.json && git -C {repo} commit -m 'stream {full} opened (#{issue})'")
    say(f"   - launch the sub-model there: gantry stream launch {prefix} --repo {repo}   (cd + claude -p with .gantry/packet.md; --cmd for another harness; --dry-run to see it)")
    say(f"   - watch: gantry stream report {prefix} --repo {repo}")
    say(f"   - then: gantry stream merge {prefix} --repo {repo}   or   gantry stream drop {prefix} --repo {repo}")


def parse_brief(text):
    """A brief is markdown. Text before the first `## issue: <title>` is the
    seed's body; each `## issue: <title>` block (optional lines `type: T`,
    `refs: [3] [S1]`, `deps: …` at its top) becomes a further workorder
    #<prefix>-0002… — the adventure as a small graph, not one blob."""
    parts = re.split(r"^##\s+issue:\s*(.+)$", text, flags=re.M)
    preamble = parts[0].strip()
    issues = []
    for i in range(1, len(parts), 2):
        title, body = parts[i].strip(), parts[i + 1]
        meta = {"type": "workorder", "refs": None, "deps": None}
        lines = body.strip("\n").splitlines()
        while lines:
            m = re.match(r"^(type|refs|deps):\s*(.+)$", lines[0].strip())
            if not m:
                break
            meta[m.group(1)] = m.group(2).strip()
            lines.pop(0)
        issues.append({"title": title, "body": "\n".join(lines).strip(), **meta})
    return preamble, issues


def plan_constraint_lines(repo, plan_rel):
    """{number: text} for the numbered items inside plan.md §2 (quoted for the packet)."""
    p = Path(repo) / plan_rel
    if not p.exists():
        return {}
    out, in_s2, cur = {}, False, None
    for line in p.read_text(encoding="utf-8").splitlines():
        if line.startswith("## 2."):
            in_s2 = True
            continue
        if in_s2 and re.match(r"^## \d", line):
            break
        if not in_s2:
            continue
        m = re.match(r"^(\d{1,3})\.\s+(.*)$", line)
        if m:
            cur = m.group(1)
            out[cur] = m.group(2).strip()
        elif cur and line.startswith("   ") and line.strip():
            out[cur] += " " + line.strip()
        else:
            cur = None
    return out


def seam_rows(repo, seams_rel):
    p = Path(repo) / seams_rel
    if not p.exists():
        return {}
    out = {}
    for line in p.read_text(encoding="utf-8").splitlines():
        m = re.match(r"^\s*\|\s*(S\d)\s*\|(.+)\|\s*$", line)
        if m:
            out[m.group(1)] = line.strip()
    return out


def write_packet(wt):
    """`.gantry/packet.md` — the self-contained first input for the stream's
    sub-model: the method in brief, who/where the stream is, its boundaries,
    the parent workorder verbatim, its own open issues verbatim, the plan
    constraints and seams those refs resolve to, the map's head, and the
    exact commands. Regenerable; never drifts from the tracker."""
    wt = Path(wt)
    ad = load_json(adapter_path(wt))
    prefix = ad.get("issue_prefix")
    if not prefix:
        die(f"{wt} is not a stream (no issue_prefix in its adapter)")
    lin = ad.get("lineage") or {}
    par = lin.get("parent") or {}
    tracker = wt / ad.get("tracker_dir", "issues")
    out = [f"# packet — stream {prefix} of {par.get('repo', '?')} · you are a gantry agent", ""]
    out.append(f"You are working **in** `{wt}` — a git worktree on branch `{lin.get('branch', 'stream/…')}` of the repo "
               f"`{par.get('repo', '?')}`, spawned by its issue **#{par.get('issue', '?')}** at "
               f"`{str(par.get('commit', ''))[:7]}` (lineage level {lin.get('level', '?')}). Your issue "
               f"namespace is **`#{prefix}-NNNN`**. Read this packet, then `GRAPH.md`, then your "
               f"open issues below — before you touch anything.")
    out.append("")
    out.append((TEMPLATES / "method-brief.md").read_text(encoding="utf-8").rstrip())
    out.append("")
    out.append("## Your boundaries (a stream's law)")
    out.append(f"- File issues only as `#{prefix}-NNNN` (`python3 {HERE / 'gantry'} issue new --repo . …`); "
               f"never a bare `#NNNN` — those are the parent's and collide on merge.")
    out.append("- `plan.md`, `seams.md` are read-only for you (amendment-only truth); `refs:` them, do not edit them.")
    out.append("- Do not edit inherited issues except to add a closing note; do not touch `.gantry/adapter.json`, "
               "`.gantry/streams.json`, `GRAPH.md`, `issues/INDEX.md` (derived / the parent's).")
    out.append("- Commit small, on this branch, each commit `… (#<id>)`; the hooks are live. Do not merge, "
               "rebase, or push — the orchestrator merges or drops this stream.")
    out.append("- When your issues are closed, say so in the last commit message; the orchestrator reads `GRAPH.md`.")
    out.append("")
    # parent issue verbatim
    pi = par.get("issue")
    ppath = tracker_issue(tracker, pi) if pi else None
    if ppath:
        out.append(f"## The parent workorder — #{pi} (verbatim)")
        out.append("```")
        out.append(ppath.read_text(encoding="utf-8").rstrip())
        out.append("```")
        out.append("")
    # own issues verbatim (open first)
    own = sorted(tracker.glob(f"{prefix}-[0-9][0-9][0-9][0-9]-*.md"))
    refs_tokens = set()
    if own:
        out.append(f"## Your issues — #{prefix}-… (verbatim; #{prefix}-0001 is the brief)")
        for f in own:
            iid, title, typ, st, refs = parse_issue_header(f)
            for tok in re.findall(r"\[([^\]]+)\]", refs or ""):
                refs_tokens.add(tok.strip())
            out.append(f"### #{iid} — {title}  ({typ}, {st})")
            out.append("```")
            out.append(f.read_text(encoding="utf-8").rstrip())
            out.append("```")
        out.append("")
    if ppath:
        _, _, _, _, prefs = parse_issue_header(ppath)
        for tok in re.findall(r"\[([^\]]+)\]", prefs or ""):
            refs_tokens.add(tok.strip())
    # constraints + seams those refs resolve to
    cons = plan_constraint_lines(wt, ad.get("plan", "plan.md"))
    seams = seam_rows(wt, ad.get("kickoff", "seams.md"))
    want_c = sorted({t for t in refs_tokens if t.isdigit()}, key=int)
    want_s = sorted({t for t in refs_tokens if re.match(r"^S\d$", t)})
    if want_c:
        out.append(f"## The constraints your refs resolve to (quoted from `{ad.get('plan', 'plan.md')}` §2 — read-only)")
        for n in want_c:
            out.append(f"- **{n}.** {cons.get(n, '(not found in plan §2 — the ref is unresolved; check GRAPH.md warnings)')}")
        out.append("")
    if want_s:
        out.append(f"## The seams your refs touch (from `{ad.get('kickoff', 'seams.md')}` — read-only)")
        for sn in want_s:
            out.append(f"- {seams.get(sn, sn + ' (row not found)')}")
        out.append("")
    other = sorted(refs_tokens - set(want_c) - set(want_s))
    if other:
        out.append(f"(other anchors referenced: {' '.join(other)} — gates/phases/holds; see GRAPH.md)")
        out.append("")
    # map head
    g = wt / "GRAPH.md"
    if g.exists():
        out.append("## GRAPH.md — the map right now (head; regenerate any time — see commands)")
        out.append("```")
        lines = g.read_text(encoding="utf-8").splitlines()
        cut = next((i for i, l in enumerate(lines) if l.startswith("sources —")), len(lines))
        out.extend(lines[:cut])
        out.append("```")
        out.append("")
    out.append("## Commands (run from this directory)")
    out.append("```sh")
    out.append(f"python3 {HERE / 'gantry'} issue new --repo . --title \"…\" --type workorder --refs <constraint#|S#|gate> [--deps \"blocks #{prefix}-0002\"]")
    out.append(f"python3 {HERE / 'gantry'} issue close <id> --by <landing-sha | human sentence>")
    out.append("python3 tools/gantry_extract.py --client .gantry/adapter.json --root . --out .gantry/out/state.json --digest GRAPH.md   # refresh the map by hand")
    out.append(f"python3 {HERE / 'gantry'} check .")
    out.append("git add -A && git commit -m \"<what> (#<id>)\"")
    out.append("```")
    out.append("")
    out.append("Start: read `GRAPH.md`, then work `#" + prefix + "-0001` (and the other open `#" + prefix +
               "-…` issues) in dependency order. Finish: every issue you filed is closed by its type's "
               "authority and `GRAPH.md` shows it.")
    pk = wt / ".gantry" / "packet.md"
    pk.parent.mkdir(exist_ok=True)
    pk.write_text("\n".join(out) + "\n", encoding="utf-8")
    return pk


def cmd_stream_packet(a):
    repo = repo_root(a.repo)
    data = load_streams(repo)
    s = find_stream(data, a.stream)
    wt = Path(s["worktree"])
    if not wt.exists():
        die(f"stream worktree missing: {wt}")
    pk = write_packet(wt)
    if a.print:
        say(pk.read_text(encoding="utf-8"))
    else:
        say(f"   packet: {pk}  ({pk.stat().st_size} bytes)")


DEFAULT_LAUNCH = ('claude -p "$(cat .gantry/packet.md)" --permission-mode acceptEdits '
                  '--allowedTools "Read" "Edit" "Write" "Glob" "Grep" "Bash(git *)" "Bash(python3 *)" '
                  '--output-format json')


def cmd_stream_launch(a):
    """cd into the stream worktree and run the sub-model there with the packet
    as its prompt. Location is the harness-independent way to make an agent a
    gantry agent: its cwd holds CLAUDE.md (auto-loaded by Claude Code), GRAPH.md,
    the tracker, the tools and the hooks — nobody has to be told to `cd`."""
    repo = repo_root(a.repo)
    data = load_streams(repo)
    s = find_stream(data, a.stream)
    wt = Path(s["worktree"])
    if not wt.exists():
        die(f"stream worktree missing: {wt}")
    write_packet(wt)
    cmd = a.cmd or DEFAULT_LAUNCH
    runs = sorted((wt / ".gantry").glob("run.*.json"))
    n = len(runs) + 1
    log = wt / ".gantry" / f"run.{n:02d}.json"
    shell = f"cd {wt} && {cmd} > {log} 2>&1"
    say(f"== gantry stream launch: {s['slug']} (prefix {s['prefix']})")
    say(f"   {shell}")
    if a.dry_run:
        say("   (--dry-run: not executed)")
        return
    r = subprocess.run(shell, shell=True)
    say(f"   exit {r.returncode}; output: {log}")
    say(f"   now: python3 {HERE / 'gantry'} stream report {s['prefix']} --repo {repo}")


def stream_issue_rows(tracker, prefix):
    rows = []
    for f in sorted(Path(tracker).glob(f"{prefix}-[0-9][0-9][0-9][0-9]-*.md")):
        iid, title, typ, st, _ = parse_issue_header(f)
        rows.append((iid, title, typ, st))
    return rows


def cmd_stream_list(a):
    repo = repo_root(a.repo)
    data = load_streams(repo)
    if not data["streams"]:
        say("no streams registered (.gantry/streams.json absent or empty)")
        return
    say(f"{'prefix':<10} {'status':<8} {'issue':<10} {'open/closed':<12} {'branch':<34} worktree")
    for s in sorted(data["streams"], key=lambda s: s["prefix"]):
        wt = Path(s["worktree"])
        if wt.exists():
            rows = stream_issue_rows(wt / load_json(adapter_path(wt)).get("tracker_dir", "issues"), s["prefix"])
            oc = "%d/%d" % (sum(1 for r in rows if r[3] == "open"), sum(1 for r in rows if r[3] != "open"))
        else:
            oc = "—"
        say(f"{s['prefix']:<10} {s['status']:<8} #{s['issue']:<9} {oc:<12} {s['branch']:<34} "
            f"{s['worktree'] if wt.exists() else '(removed)'}")


def cmd_stream_report(a):
    """The orchestrator's check: what each stream's GRAPH.md says now."""
    repo = repo_root(a.repo)
    data = load_streams(repo)
    targets = [find_stream(data, a.stream)] if a.stream else \
        [s for s in data["streams"] if s["status"] == "open" or a.all]
    if not targets:
        say("no open streams")
        return
    for s in targets:
        wt = Path(s["worktree"])
        head = git(repo, "rev-parse", "--short", s["branch"], check=False).stdout.strip() or "?"
        last = git(repo, "log", "-1", "--format=%h %s", s["branch"], check=False).stdout.strip()
        ahead = git(repo, "rev-list", "--count", f"{s['from']}..{s['branch']}", check=False).stdout.strip()
        say(f"== stream {s['slug']}  prefix {s['prefix']}  [{s['status']}]  branch {s['branch']} @ {head}"
            f"  ({ahead} commits since spawn)")
        say(f"   last: {last}")
        if wt.exists():
            graph = (wt / "GRAPH.md").read_text(encoding="utf-8") if (wt / "GRAPH.md").exists() else ""
            src = str(wt / "GRAPH.md")
        else:
            r = git(repo, "show", f"{s['branch']}:GRAPH.md", check=False)
            graph = r.stdout if r.returncode == 0 else ""
            src = f"git show {s['branch']}:GRAPH.md"
        if not graph:
            say("   (no GRAPH.md on the stream yet)")
            continue
        say(f"   GRAPH.md ({src}):")
        keep = ("lineage:", "gates latched:", "seams ", "open items", "  #", "closed/resolved:",
                "dependency edges", "streams open", "streams closed")
        for line in graph.splitlines():
            if line.startswith("sources —") or line.startswith("## proposed"):
                break
            if line.startswith(keep) or (line.startswith("  ") and line.strip()):
                say("     " + line)
        rows = stream_issue_rows(wt / load_json(adapter_path(wt)).get("tracker_dir", "issues"), s["prefix"]) if wt.exists() else []
        if rows:
            say(f"   {s['prefix']}-issues: " + " · ".join(f"#{iid} {st}" for iid, _, _, st in rows))
        say("")


def cmd_stream_merge(a):
    repo = repo_root(a.repo)
    data = load_streams(repo)
    s = find_stream(data, a.stream)
    if s["status"] != "open":
        die(f"stream {s['slug']} is {s['status']}")
    if not a.finish:
        if git(repo, "status", "--porcelain", "--untracked-files=no", check=False).stdout.strip():
            die("parent has uncommitted changes — commit or stash before merging a stream")
        say(f"== gantry stream merge: {s['slug']} ({s['branch']}) -> "
            f"{git(repo, 'rev-parse', '--abbrev-ref', 'HEAD').stdout.strip()}")
        git(repo, "merge", "--no-ff", "--no-commit", s["branch"], check=False)
        conflicts = git(repo, "diff", "--name-only", "--diff-filter=U", check=False).stdout.split()
        # derived / per-branch files: the parent's version wins, then regenerates
        tdir = load_adapter(repo).get("tracker_dir", "issues")
        derived = {".gantry/adapter.json", ".gantry/streams.json", "GRAPH.md", f"{tdir}/INDEX.md", "CLAUDE.md"}
        for f in list(conflicts):
            if f in derived:
                git(repo, "checkout", "--ours", "--", f)
                git(repo, "add", "--", f)
                conflicts.remove(f)
        if conflicts:
            say("   CONFLICTS in real content — the tool stops here (merge left in progress):")
            for f in conflicts:
                say(f"     {f}")
            die(f"resolve them and `git add` each file, then run:\n"
                f"       gantry stream merge {s['prefix']} --finish\n"
                f"   (which restores the parent's adapter, regenerates GRAPH.md/INDEX.md, records the "
                f"stream as merged and makes the merge commit)")
    else:
        say(f"== gantry stream merge --finish: {s['slug']}")
    # the parent keeps ITS adapter, ledger and briefing; derived files regenerate
    for f in (".gantry/adapter.json", ".gantry/streams.json", "CLAUDE.md"):
        git(repo, "checkout", "HEAD", "--", f, check=False)
    data = load_streams(repo)
    s = find_stream(data, a.stream)
    s["status"] = "merged"
    s["merged_from"] = git(repo, "rev-parse", s["branch"]).stdout.strip()
    save_streams(repo, data)
    run_extract(repo, quiet=True)
    run_gen_index(repo, quiet=True)
    git(repo, "add", "-A")
    r = git(repo, "commit", "-q", "-m", f"merge stream {s['slug']} (#{s['issue']})",
            "-m", f"gantry stream merge: prefix {s['prefix']} folded into the parent; parent adapter "
                  f"kept; GRAPH.md + INDEX.md regenerated.", check=False)
    if r.returncode != 0:
        die(f"merge commit failed:\n{(r.stderr or r.stdout).strip()}")
    say(f"   merged + committed: merge stream {s['slug']} (#{s['issue']})")
    if not a.keep_worktree:
        wt = Path(s["worktree"])
        if wt.exists():
            git(repo, "worktree", "remove", "--force", str(wt))
            say(f"   worktree removed: {wt}")
    if a.delete_branch:
        git(repo, "branch", "-D", s["branch"])
        say(f"   branch deleted: {s['branch']}")
    else:
        say(f"   branch kept: {s['branch']} (--delete-branch to remove)")


def cmd_stream_drop(a):
    repo = repo_root(a.repo)
    data = load_streams(repo)
    s = find_stream(data, a.stream)
    say(f"== gantry stream drop: {s['slug']} (prefix {s['prefix']})")
    wt = Path(s["worktree"])
    if wt.exists():
        git(repo, "worktree", "remove", "--force", str(wt))
        say(f"   worktree removed: {wt}")
    if not a.keep_branch:
        git(repo, "branch", "-D", s["branch"], check=False)
        say(f"   branch deleted: {s['branch']}")
    s["status"] = "dropped"
    save_streams(repo, data)
    say(f"   .gantry/streams.json: {s['slug']} → dropped (prefix stays reserved; commit it, refs #{s['issue']})")


# ------------------------------------------------------------------ issue ----

def cmd_issue_new(a):
    """Write a correctly-formed issue file: the header grammar is exact and a
    mistake there is silent (the issue floats) — so a tool writes it."""
    repo = repo_root(a.repo)
    ad = load_adapter(repo)
    tracker = repo / ad.get("tracker_dir", "issues")
    tracker.mkdir(exist_ok=True)
    prefix = ad.get("issue_prefix")
    if prefix:
        iid = f"{prefix}-{next_free_prefixed(tracker, prefix):04d}"
    else:
        lo, hi = ad.get("issue_min", 1) or 1, ad.get("issue_max", 9999) or 9999
        iid = f"{next_free_issue(tracker, lo, hi):04d}"
    if a.number:
        iid = a.number
        if tracker_issue(tracker, iid):
            die(f"#{iid} exists")
    slug = re.sub(r"[^a-z0-9-]+", "-", (a.slug or a.title).lower()).strip("-")[:48]
    if a.type == "ambiguity" and not slug.startswith("ambiguity-"):
        slug = "ambiguity-" + slug
    refs = " ".join(t if t.startswith("[") else f"[{t}]" for t in a.refs)
    if not refs:
        die("--refs is required (≥1 upstream anchor: a constraint number, S#, gate, Phase, Q#) — "
            "an issue with no resolvable ref is floating scaffold (SPEC §5 invariant 1)")
    closed_by = "<a human sentence>" if a.type in HUMAN_GATED else "<sha>"
    head = [f"# #{iid} — {a.title}",
            f"type: {a.type}        status: open",
            f"refs: {refs}   opened: {a.opened}   closed-by: {closed_by}"]
    if a.deps:
        head.append(f"deps: {a.deps}")
    body = render("issue-workorder.md", constraints=a.constraints or "<what must be true when this closes — one testable sentence per constraint; each traces to a plan constraint above>",
                  depends="<the issues this needs first — mirror them on the deps: line as blocks/awaits-stamp/defers-to/informs>",
                  approaches="<the technical ways considered; the one chosen and why; what a seam would let you swap later>",
                  exit="<the test / observation that latches this>")
    path = tracker / f"{iid}-{slug}.md"
    path.write_text("\n".join(head) + "\n\n" + body, encoding="utf-8")
    say(f"   created: {path.relative_to(repo)}")
    say(f"   fill the body (constraints · depends on · approaches · exit); commit with '(#{iid})'")


def cmd_issue_close(a):
    repo = repo_root(a.repo)
    ad = load_adapter(repo)
    tracker = repo / ad.get("tracker_dir", "issues")
    iid = a.id.lstrip("#")
    pfx, _, seq = iid.rpartition("-")
    iid = f"{pfx}-{int(seq):04d}" if pfx else f"{int(seq):04d}"
    p = tracker_issue(tracker, iid)
    if not p:
        die(f"#{iid} not found in {tracker}")
    _, _, typ, st, _ = parse_issue_header(p)
    if st != "open":
        die(f"#{iid} is already {st}")
    sha_like = re.match(r"^[0-9a-f]{7,40}$", a.by) is not None
    if typ in HUMAN_GATED and sha_like:
        die(f"#{iid} is type '{typ}' — human-gated: --by must be a human sentence (who decided, what), "
            f"never a sha (SPEC §3)")
    if typ not in HUMAN_GATED and not sha_like:
        say(f"   note: '{typ}' is commit-closable; --by is usually the landing sha")
    lines = p.read_text(encoding="utf-8").splitlines()
    for i, l in enumerate(lines[:6]):
        if re.match(r"^type:\s*\S+\s+status:\s*open", l):
            lines[i] = re.sub(r"status:\s*open", "status: closed", l, count=1)
        if l.startswith("refs:"):
            lines[i] = re.sub(r"closed-by:\s*.*$", f"closed-by: {a.by}", l)
    p.write_text("\n".join(lines) + "\n", encoding="utf-8")
    say(f"   closed: #{iid} — closed-by: {a.by}   (commit it: 'close #{iid} …')")


# ------------------------------------------------------- the short views ----
#
# Token economy: an agent reads the map every session and issue files all day.
# These print the smallest thing that answers the question — GRAPH.md without its
# navigation index, only the open items, only what is unblocked, one issue with
# the constraints it refs already resolved — so nobody pays for a full file read.

SECTION_HEADS = ("gates latched:", "seams ", "open items", "dependency edges",
                 "closed/resolved:", "sources —", "## proposed", "lineage:", "streams ")


def graph_text(repo):
    g = Path(repo) / "GRAPH.md"
    if not g.exists():
        die(f"no GRAPH.md in {repo} — run `g refresh` (or gantry adopt) first")
    return g.read_text(encoding="utf-8")


def cmd_map(a):
    """GRAPH.md minus the navigation index (and minus the proposed annex unless
    asked) — the part an agent actually reasons over."""
    repo = repo_root(a.repo)
    lines = graph_text(repo).splitlines()
    if a.full:
        say("\n".join(lines))
        return
    out, skip = [], False
    for line in lines:
        if line.startswith("sources —"):
            skip = True
            continue
        if line.startswith("## proposed"):
            skip = not a.proposed
        if skip and line.startswith(("gates", "seams", "open items", "dependency", "closed/")):
            skip = False
        if not skip:
            out.append(line)
    while out and not out[-1].strip():
        out.pop()
    say("\n".join(out))
    say("")
    say("(`g map --full` adds the sources index; `--proposed` the annex; "
        "`g show <id>` prints one issue with its constraints resolved)")


def section(lines, head):
    out, on = [], False
    for line in lines:
        if line.startswith(head):
            on = True
            continue
        if on and (not line.strip() or any(line.startswith(h) for h in SECTION_HEADS)):
            break
        if on:
            out.append(line)
    return out


def cmd_open(a):
    repo = repo_root(a.repo)
    lines = graph_text(repo).splitlines()
    items = section(lines, "open items")
    if not items:
        say("no open items")
        return
    say("\n".join(l.strip() for l in items))
    edges = [l.strip() for l in section(lines, "dependency edges")]
    ids = {re.match(r"#(\S+)", l.strip()).group(1) for l in items if re.match(r"#(\S+)", l.strip())}
    rel = [e for e in edges if any(f"#{i}" in e for i in ids)]
    if rel:
        say("edges: " + " · ".join(rel))


def cmd_next(a):
    """Open items nothing blocks — what may be started right now."""
    repo = repo_root(a.repo)
    lines = graph_text(repo).splitlines()
    items = [l.strip() for l in section(lines, "open items")]
    edges = [l.strip() for l in section(lines, "dependency edges")]
    open_ids = {}
    for l in items:
        m = re.match(r"#(\S+)\s+(\S+)\s+(\S+)", l)
        if m:
            open_ids[m.group(1)] = l
    blocked = {}
    for e in edges:
        m = re.match(r"#(\S+)\s+—(\S+)→\s+#(\S+)", e)
        if not m:
            continue
        src, typ, tgt = m.group(1), m.group(2), m.group(3)
        # "A blocks B" → B waits on A; "A defers-to B"/"awaits-stamp B" → A waits on B
        if typ == "blocks" and src in open_ids and tgt in open_ids:
            blocked.setdefault(tgt, []).append(f"#{src}")
        if typ in ("defers-to", "awaits-stamp") and tgt in open_ids and src in open_ids:
            blocked.setdefault(src, []).append(f"#{tgt}")
    if not open_ids:
        say("no open items")
        return
    ready = [l for i, l in open_ids.items() if i not in blocked]
    say("ready (nothing open blocks these):")
    for l in ready or ["  (none — everything open is waiting)"]:
        say("  " + l if not l.startswith("  ") else l)
    if blocked:
        say("waiting:")
        for i, on in sorted(blocked.items()):
            say(f"  #{i} ← {' '.join(sorted(set(on)))}")


def cmd_show(a):
    """One issue, plus the plan constraints / seam rows its refs resolve to."""
    repo = repo_root(a.repo)
    ad = load_adapter(repo)
    tracker = repo / ad.get("tracker_dir", "issues")
    iid = a.id.lstrip("#")
    pfx, _, seq = iid.rpartition("-")
    if seq.isdigit():
        iid = f"{pfx}-{int(seq):04d}" if pfx else f"{int(seq):04d}"
    p = tracker_issue(tracker, iid)
    if not p:
        die(f"#{iid} not found in {tracker}")
    text = p.read_text(encoding="utf-8").rstrip()
    say(text)
    _, _, _, _, refs = parse_issue_header(p)
    toks = [t.strip() for t in re.findall(r"\[([^\]]+)\]", refs or "")]
    cons = plan_constraint_lines(repo, ad.get("plan", "plan.md"))
    seams = seam_rows(repo, ad.get("kickoff", "seams.md"))
    resolved = []
    for t in toks:
        if t.isdigit() and t in cons:
            resolved.append(f"  [{t}] {cons[t]}")
        elif re.match(r"^S\d$", t) and t in seams:
            resolved.append(f"  [{t}] {seams[t]}")
    if resolved:
        say("")
        say("refs resolve to:")
        say("\n".join(resolved))


def cmd_refresh(a):
    """Regenerate GRAPH.md + INDEX.md; print one line (plus any warnings)."""
    repo = repo_root(a.repo)
    r = run_extract(repo, quiet=True)
    out = (r.stdout or "") + (r.stderr or "")
    if r.returncode != 0:
        die(f"extract failed:\n{out.strip()}")
    rev = re.search(r"REV (\S+)\s+@ client (\S+)", out)
    ents = re.search(r"entities: (\d+)", out)
    warn = out.split("warnings (", 1)
    run_gen_index(repo, quiet=True)
    say(f"GRAPH.md + INDEX.md refreshed · REV {rev.group(1) if rev else '?'} "
        f"@ {rev.group(2) if rev else '?'} · {ents.group(1) if ents else '?'} entities")
    if len(warn) > 1:
        say("warnings (" + warn[1].strip())


# ------------------------------------------------------------------ trees ----

def _tree_roots(repo):
    """Ordered --root specs: .gantry/adapter.json "mmt_roots" (name -> path, relative to
    the repo), else the repo itself under its directory name."""
    ad = Path(repo) / ".gantry/adapter.json"
    roots = {}
    if ad.exists():
        try:
            roots = json.loads(ad.read_text()).get("mmt_roots", {}) or {}
        except Exception:
            roots = {}
    if not roots:
        roots = {Path(repo).resolve().name: "."}
    return [f"{n}={(Path(repo) / p).resolve()}" for n, p in roots.items()]


def cmd_tree_new(a):
    """Write trees/<yyyymmdd-HHMMSS>-<slug>.mmt from stdin (or --from FILE), then render it (#0019):
    the tree is emitted ONCE — as this command's stdin — and what comes back is the page URL,
    the level-1 lint and the unresolved tokens. The chat reply is the URL, never the tree again."""
    repo = Path(a.repo)
    src = Path(a.from_file).read_text() if a.from_file else sys.stdin.read()
    if not src.strip():
        die("tree new: empty input (pipe the tree on stdin, or --from FILE)")
    (repo / "trees").mkdir(exist_ok=True)
    # yyyymmdd-HHMMSS-<slug>: a tree is a moment; the index sorts these newest first
    name = f"{datetime.now().strftime('%Y%m%d-%H%M%S')}-{re.sub(r'[^a-z0-9]+', '-', a.slug.lower()).strip('-')}.mmt"
    out = repo / "trees" / name
    if out.exists() and not a.force:
        die(f"tree new: {out} exists (use --force)")
    out.write_text(src.strip("\n") + "\n")
    if a.no_render:
        say(f"trees/{name} written · render: python3 tools/g tree render trees/{name}")
        return
    say(f"trees/{name} written")
    sys.exit(_render_trees(repo, [out], strict=a.strict, open_=a.open))


def _render_trees(repo, files, *, strict=False, open_=False, gc=False):
    """Run the repo's mmt.py over FILES into .site/mmt/ with the repo's roots. Prints, per tree:
    the file:// URL of its page, then mmt's own summary/lint/unresolved lines. Returns the rc."""
    mmt = repo / "tools/mmt.py"
    if not mmt.exists():
        mmt = HERE / "mmt.py"
    out = repo / ".site/mmt"
    args = ["--out", str(out)]
    for r in _tree_roots(repo):
        args += ["--root", r]
    rc = 0
    for i, f in enumerate(files):
        last = i == len(files) - 1
        r = subprocess.run([sys.executable, str(mmt), str(f), *args, *(["--strict"] if strict else []),
                            *(["--gc"] if gc and last else [])],
                           capture_output=True, text=True)
        lines = r.stdout.splitlines()
        if lines and lines[0].endswith(".html"):
            lines[0] = Path(lines[0]).resolve().as_uri()
        for ln in lines:
            say(ln)
        if r.stderr.strip():
            say(r.stderr.rstrip())
        rc = rc or r.returncode
    if open_:
        subprocess.Popen(["xdg-open", str(out / "index.html")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return rc


def cmd_tree_render(a):
    """Render one tree, or every trees/*.mmt, to .site/mmt/ with the repo's roots."""
    repo = Path(a.repo)
    files = [Path(f) for f in a.files]
    if a.all or not files:
        files = sorted((repo / "trees").glob("*.mmt"))
    if not files:
        die("tree render: no trees/*.mmt and no file given")
    rc = _render_trees(repo, files, strict=a.strict, open_=a.open, gc=bool(a.all))
    if rc:
        sys.exit(rc)


# The ->@ [type] vocabulary a tree uses, mapped onto the extractor's dependency types so a
# tree edge between two issues can be checked against the tracker (#0021). "^" = the tracker
# edge runs the other way: "A ->@B [depends]" is the tracker's "B blocks A". A repo's adapter
# may give mmt_edges as a dict {type: dep-type|null} to override; a list means these defaults.
EDGE_TO_DEP = {"depends": "^blocks", "blocks": "blocks", "awaits-stamp": "awaits-stamp",
               "defers-to": "defers-to", "serves": "informs", "informs": "informs",
               "proves": "informs", "evidence": "informs"}


def cmd_tree_diff(a):
    """Compare a tree's issue-to-issue ->@ edges with GRAPH.md's dependency edges
    (.gantry/out/state.json). Reports tree edges the tracker lacks, and how the two
    graphs overlap. Exit 1 if any tree edge is missing from the tracker."""
    repo = Path(a.repo)
    mmt = repo / "tools/mmt.py"
    if not mmt.exists():
        mmt = HERE / "mmt.py"
    st = repo / ".gantry/out/state.json"
    if not st.exists():
        die("tree diff: .gantry/out/state.json missing — run tools/g refresh first")
    ad = load_adapter(repo)
    emap = dict(EDGE_TO_DEP)
    if isinstance(ad.get("mmt_edges"), dict):
        emap.update(ad["mmt_edges"])
    with tempfile.TemporaryDirectory() as td:
        ej = Path(td) / "edges.json"
        args = [sys.executable, str(mmt), a.tree, "--out", str(repo / ".site/mmt"), "--edges", str(ej)]
        for r in _tree_roots(repo):
            args += ["--root", r]
        r = subprocess.run(args, capture_output=True, text=True)
        if r.returncode not in (0, 1) or not ej.exists():
            die(f"tree diff: render failed\n{r.stdout}{r.stderr}")
        ex = json.loads(ej.read_text())
    ents = json.load(open(st))["entities"]
    by_ref = {b["ref"]: e for e in ents for b in e.get("bindings", []) if b["ref"].startswith("#")}
    tracker = {(e["id"], rel["type"], rel["target"]) for e in ents for rel in e.get("relations", [])
               if rel["type"] in ("blocks", "awaits-stamp", "defers-to", "informs")}
    nodes = {n["n"]: n for n in ex["nodes"]}
    own = {spec.split("=", 1)[0] for spec in _tree_roots(repo) if Path(spec.split("=", 1)[1]).resolve() == repo.resolve()}

    def issue_of(n):
        """The one issue of THIS repo a node names (a node naming two is not an edge endpoint)."""
        toks = [t["token"].split(":")[-1] for t in nodes[n]["tokens"] if t["kind"] == "issue" and t["root"] in own]
        return toks[0] if len(toks) == 1 else None

    checked = missing = 0
    say(f"== tree diff: {a.tree} vs {st.relative_to(repo)}")
    for e in ex["edges"]:
        if e["type"] in (None, "mentions", "todo") or e.get("to") is None:
            continue
        dep = emap.get(e["type"])
        if not dep:
            continue
        src, dst = issue_of(e["from"]), issue_of(e["to"])
        if not (src and dst) or src not in by_ref or dst not in by_ref:
            continue
        checked += 1
        sid, did = by_ref[src]["id"], by_ref[dst]["id"]
        if dep.startswith("^"):
            dep, sid, did, src_, dst_ = dep[1:], did, sid, dst, src
        else:
            src_, dst_ = src, dst
        if (sid, dep, did) in tracker:
            say(f"   ok       L{e['line']}: {src} —{e['type']}→ {dst}   (tracker: {dep})")
        else:
            missing += 1
            have = sorted(t for (s, t, d) in tracker if s == sid and d == did)
            say(f"   MISSING  L{e['line']}: {src} —{e['type']}→ {dst}   tracker has {have or 'no edge'}; "
                f"expected `deps: {dep} {dst_}` on {src_}")
    say(f"   {checked} issue→issue edges checked · {missing} missing from the tracker")
    sys.exit(1 if missing else 0)


# ---------------------------------------------------------------- install ----

def cmd_install(a):
    """Symlink this toolbox's entry point onto PATH as `gantry`, so every
    instruction is four characters instead of an absolute path (and every agent
    session spends fewer tokens typing it)."""
    bindir = Path(a.bin).expanduser()
    bindir.mkdir(parents=True, exist_ok=True)
    link = bindir / a.name
    target = HERE / "gantry"
    if link.exists() or link.is_symlink():
        cur = link.resolve() if link.is_symlink() else link
        if cur == target.resolve():
            say(f"   already installed: {link} -> {target}")
        elif a.force:
            link.unlink()
            link.symlink_to(target)
            say(f"   replaced: {link} -> {target}  (was {cur})")
        else:
            die(f"{link} exists and points at {cur} — pass --force to replace it")
    else:
        link.symlink_to(target)
        say(f"   installed: {link} -> {target}")
    on_path = str(bindir) in (os.environ.get("PATH") or "").split(os.pathsep)
    say(f"   PATH: {'yes' if on_path else 'NO — add it'} ({bindir})")
    if not on_path:
        say(f'     echo \'export PATH="{bindir}:$PATH"\' >> ~/.bashrc && exec bash')
    say(f"   try: {a.name} map --repo <a-gantry-repo>   ·   {a.name} --help")


# ------------------------------------------------------------------ check ----

def cmd_check(a):
    repo = repo_root(a.repo)
    ad = load_adapter(repo)
    ok = True
    say(f"== gantry check: {repo}")
    r = run_extract(repo, check=True)
    ok &= r.returncode == 0
    r = run_gen_index(repo, check=True)
    ok &= r.returncode == 0
    lo, hi = ad.get("issue_min", 0) or 0, ad.get("issue_max", 0) or 0
    lin = ad.get("lineage") or {}
    level = int(lin.get("level", 0))
    exp = band_for_level(level)
    if (lo or hi) and (lo, hi) != exp and not ad.get("issue_prefix"):
        say(f"   lineage: level {level} expects band #{exp[0]:04d}–#{exp[1]:04d}, adapter says "
            f"#{lo:04d}–#{hi:04d}")
        ok = False
    data = load_streams(repo)
    for s in data["streams"]:
        wt = Path(s["worktree"])
        if s["status"] == "open" and not wt.exists():
            say(f"   stream {s['slug']}: open but worktree missing ({s['worktree']})")
            ok = False
    say("   check: ok" if ok else "   check: FAILED (see above)")
    sys.exit(0 if ok else 1)


# ------------------------------------------------------------------- main ----

DEFAULT_REPO = default_repo()


def main():
    ap = argparse.ArgumentParser(prog="gantry", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("new", help="create a new gantry repo in an empty/absent dir")
    p.add_argument("dir")
    p.add_argument("--name")
    p.add_argument("--core-prefix", action="append", default=[])
    p.add_argument("--no-commit", action="store_true")
    p.set_defaults(fn=cmd_new)

    p = sub.add_parser("adopt", help="put an existing git repo (empty or with content) on the method")
    p.add_argument("repo", nargs="?", default=DEFAULT_REPO)
    p.add_argument("--name")
    p.add_argument("--core-prefix", action="append", default=[])
    p.add_argument("--link-tools", action="store_true",
                   help="symlink tools/*.py to this toolbox instead of copying (self-hosting)")
    p.add_argument("--no-seed", action="store_true", help="do not seed the M0 issue")
    p.add_argument("--fresh-tools", action="store_true",
                   help="upgrade: overwrite the client's tools/*.py with this toolbox's current copies")
    p.add_argument("--no-commit", action="store_true")
    p.set_defaults(fn=cmd_adopt)

    p = sub.add_parser("fork", help="new separate repo born from a gantry-adopted base (next level)")
    p.add_argument("base")
    p.add_argument("new_dir")
    p.add_argument("--name")
    p.add_argument("--level", type=int)
    p.add_argument("--issue-min", type=int)
    p.add_argument("--keep-open", action="store_true")
    p.add_argument("--exclude", action="append", default=[])
    p.add_argument("--fresh-tools", action="store_true", help="ship this toolbox's current tools/ instead of the base's copies")
    p.add_argument("--no-commit", action="store_true")
    p.set_defaults(fn=cmd_fork)

    p = sub.add_parser("stream", help="worktree streams for an orchestrating agent (prefix namespaces)")
    ss = p.add_subparsers(dest="scmd", required=True)
    q = ss.add_parser("new", help="spawn a stream from an issue: worktree beside the repo, own prefix, seeded brief")
    q.add_argument("--issue", required=True, help="the spawning workorder: NNNN or <prefix>-NNNN")
    q.add_argument("--slug", required=True)
    q.add_argument("--brief", help="markdown file (or - for stdin) with the constraints/workorders to fulfil; becomes #<prefix>-0001's body")
    q.add_argument("--prefix", help="override the allocated prefix ([a-z][a-z0-9]{0,11})")
    q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_stream_new)
    q = ss.add_parser("list"); q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_stream_list)
    q = ss.add_parser("report", help="what each stream's GRAPH.md says now — the orchestrator's check")
    q.add_argument("stream", nargs="?", help="prefix or slug (default: all open)")
    q.add_argument("--all", action="store_true", help="include merged/dropped")
    q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_stream_report)
    q = ss.add_parser("packet", help="(re)write <worktree>/.gantry/packet.md — the sub-model's self-contained first input")
    q.add_argument("stream", help="prefix or slug"); q.add_argument("--print", action="store_true")
    q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_stream_packet)
    q = ss.add_parser("launch", help="cd into the stream worktree and run the sub-model with the packet as prompt")
    q.add_argument("stream", help="prefix or slug"); q.add_argument("--cmd", help="shell command to run in the worktree (default: headless claude -p with the packet)")
    q.add_argument("--dry-run", action="store_true"); q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_stream_launch)
    q = ss.add_parser("merge"); q.add_argument("stream", help="prefix or slug"); q.add_argument("--repo", default=DEFAULT_REPO)
    q.add_argument("--keep-worktree", action="store_true"); q.add_argument("--delete-branch", action="store_true")
    q.add_argument("--finish", action="store_true", help="after resolving conflicts by hand: bookkeeping + merge commit")
    q.set_defaults(fn=cmd_stream_merge)
    q = ss.add_parser("drop"); q.add_argument("stream", help="prefix or slug"); q.add_argument("--repo", default=DEFAULT_REPO)
    q.add_argument("--keep-branch", action="store_true"); q.set_defaults(fn=cmd_stream_drop)

    p = sub.add_parser("issue", help="write / close a correctly-formed issue (the header grammar is exact)")
    ss = p.add_subparsers(dest="icmd", required=True)
    q = ss.add_parser("new")
    q.add_argument("-t", "--title", required=True)
    q.add_argument("-T", "--type", default="workorder", help="milestone|workorder|bug|ambiguity|freeze-request|amendment-proposal|…")
    q.add_argument("-r", "--refs", nargs="+", default=[], help="upstream anchors: 3 S1 m1 PhaseB Q1 (≥1 required)")
    q.add_argument("--deps", help='e.g. "blocks #0004; informs #0003"')
    q.add_argument("--slug"); q.add_argument("--number", help="force an id (default: next free in this repo's namespace)")
    q.add_argument("--opened", default="seed"); q.add_argument("--constraints", help="the constraints this issue makes true (body)")
    q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_issue_new)
    q = ss.add_parser("close"); q.add_argument("id"); q.add_argument("-b", "--by", required=True, help="landing sha, or a human sentence for human-gated types")
    q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_issue_close)

    p = sub.add_parser("map", help="GRAPH.md without its navigation index — the map you reason over")
    p.add_argument("--full", action="store_true", help="the whole file, sources index included")
    p.add_argument("--proposed", action="store_true", help="keep the proposed annex")
    p.add_argument("--repo", default=DEFAULT_REPO); p.set_defaults(fn=cmd_map)

    p = sub.add_parser("open", help="just the open items (+ their edges)")
    p.add_argument("--repo", default=DEFAULT_REPO); p.set_defaults(fn=cmd_open)

    p = sub.add_parser("next", help="open items nothing blocks — what may be started now")
    p.add_argument("--repo", default=DEFAULT_REPO); p.set_defaults(fn=cmd_next)

    p = sub.add_parser("show", help="one issue + the constraints/seams its refs resolve to")
    p.add_argument("id"); p.add_argument("--repo", default=DEFAULT_REPO); p.set_defaults(fn=cmd_show)

    p = sub.add_parser("refresh", help="regenerate GRAPH.md + INDEX.md, one line of output")
    p.add_argument("--repo", default=DEFAULT_REPO); p.set_defaults(fn=cmd_refresh)

    p = sub.add_parser("install", help="symlink this toolbox onto PATH as `gantry`")
    p.add_argument("--bin", default="~/.local/bin"); p.add_argument("--name", default="gantry")
    p.add_argument("--force", action="store_true"); p.set_defaults(fn=cmd_install)

    p = sub.add_parser("check", help="CI gate: extract --check, gen_index --check, lineage sanity")
    p.add_argument("repo", nargs="?", default=DEFAULT_REPO)
    p.set_defaults(fn=cmd_check)

    p = sub.add_parser("tree", help="MindMapTrees: trees/*.mmt → .site/mmt/ linked pages (designDocs/MindMapTreeFormat-0.1.md)")
    ss = p.add_subparsers(dest="tcmd", required=True)
    q = ss.add_parser("new", help="write trees/<yyyymmdd-HHMMSS>-<slug>.mmt from stdin or --from FILE, render it, print the page URL + lint")
    q.add_argument("slug"); q.add_argument("--from", dest="from_file"); q.add_argument("--force", action="store_true")
    q.add_argument("--no-render", action="store_true", help="write the file only (default: render it and print the file:// URL + lint)")
    q.add_argument("--strict", action="store_true"); q.add_argument("--open", action="store_true")
    q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_tree_new)
    q = ss.add_parser("render", help="render one tree, or --all of trees/, to .site/mmt/")
    q.add_argument("files", nargs="*"); q.add_argument("--all", action="store_true"); q.add_argument("--open", action="store_true")
    q.add_argument("--strict", action="store_true"); q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_tree_render)
    q = ss.add_parser("diff", help="check a tree's issue→issue ->@ [type] edges against GRAPH.md's dependency edges (#0021)")
    q.add_argument("tree"); q.add_argument("--repo", default=DEFAULT_REPO); q.set_defaults(fn=cmd_tree_diff)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
